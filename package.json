{
  "name": "fitroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run build -w @fitroom/shared && concurrently -n client,server -c blue,green \"npm run dev -w @fitroom/client\" \"npm run dev -w @fitroom/server\"",
    "build": "npm run build -w @fitroom/shared && npm run build -w @fitroom/server && npm run build -w @fitroom/client",
    "typecheck": "npm run build -w @fitroom/shared && npm run typecheck -w @fitroom/shared && npm run typecheck -w @fitroom/server && npm run typecheck -w @fitroom/client",
    "lint": "eslint . && prettier --check .",
    "validate": "npm run validate -w @fitroom/shared",
    "dev:worker": "npm run build && wrangler dev",
    "check:worker": "tsx scripts/check-worker.ts",
    "check:page-basics": "tsx scripts/check-page-basics.ts",
    "deploy": "node scripts/deploy.mjs",
    "check:gateway": "npm run check:gateway -w @fitroom/server",
    "check:recommend": "npm run check:recommend -w @fitroom/server",
    "check:assistant": "npm run check:assistant -w @fitroom/server",
    "check:render": "npm run check:render -w @fitroom/server",
    "check:room-api": "npm run check:room-api -w @fitroom/server",
    "check:sam-decode": "tsx scripts/check-sam-decode.ts",
    "check:geometry": "tsx scripts/check-geometry.ts",
    "check:example-geometry": "tsx scripts/check-example-geometry.ts",
    "check:photo-camera": "tsx scripts/check-photo-camera.ts",
    "check:example-cameras": "npm run check:example-cameras -w @fitroom/client",
    "check:ar": "npm run check:ar -w @fitroom/client",
    "check:photo-view": "npm run check:photo-view -w @fitroom/client",
    "check:surfaces": "tsx scripts/check-surfaces.ts",
    "check:light-maps": "tsx scripts/check-light-maps.ts",
    "check:live-rooms": "tsx scripts/check-live-rooms.ts",
    "check:static": "tsx server/scripts/check-static.ts",
    "check:photo-intake": "npm run check:photo-intake -w @fitroom/client",
    "check:photo-cards": "npm run check:photo-cards -w @fitroom/client",
    "check:example-room": "npm run check:example-room -w @fitroom/client",
    "check:guidance": "npm run check:guidance -w @fitroom/client",
    "check:notices": "npm run check:notices -w @fitroom/client",
    "check:credits": "npm run check:credits -w @fitroom/client",
    "check:guide": "npm run check:guide -w @fitroom/client",
    "check:states": "npm run check:states -w @fitroom/client",
    "check:labels": "npm run check:labels -w @fitroom/client",
    "check:confirm-walls": "npm run check:confirm-walls -w @fitroom/client",
    "check:empty-fit": "npm run check:empty-fit -w @fitroom/client",
    "check:orbit-resolution": "npm run check:orbit-resolution -w @fitroom/client",
    "check:pointer-ownership": "npm run check:pointer-ownership -w @fitroom/client",
    "check:scene-sync": "npm run check:scene-sync -w @fitroom/client",
    "check:same-room-layout": "npm run check:same-room-layout -w @fitroom/client",
    "check:contrast": "npm run check:contrast -w @fitroom/client",
    "check:toolbar": "npm run check:toolbar -w @fitroom/client",
    "check:capped": "npm run check:capped -w @fitroom/client",
    "check:catalog-format": "npm run check:catalog-format -w @fitroom/client",
    "check:store": "npm run check:store -w @fitroom/client",
    "check:store-entry": "npm run check:store-entry -w @fitroom/client",
    "demo:record": "npm run demo:record -w @fitroom/server --",
    "demo:import": "npm run demo:import -w @fitroom/server",
    "start": "npm run start -w @fitroom/server"
  },
  "overrides": {
    "@google/model-viewer": {
      "three": "0.186.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.153.0"
  }
}
