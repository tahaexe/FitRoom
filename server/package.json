{
  "name": "@fitroom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx scripts/build-worker-data.ts && tsx watch src/index.ts",
    "build": "tsx scripts/build-worker-data.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsx scripts/build-worker-data.ts && tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "check:gateway": "tsx scripts/check-gateway.ts",
    "check:recommend": "tsx scripts/check-recommend.ts",
    "check:assistant": "tsx scripts/check-assistant.ts",
    "check:render": "tsx scripts/check-render.ts",
    "check:room-api": "tsx scripts/check-room-api.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "demo:import": "tsx scripts/import-demo.ts"
  },
  "dependencies": {
    "@fitroom/shared": "*",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
